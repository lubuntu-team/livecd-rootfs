#!/bin/bash -eux

IMAGE_STR="# CLOUD_IMG: This file was created/modified by the Cloud Image build process"
FS_LABEL="cloudimg-rootfs"

. config/functions
. config/binary

. config/bootstrap

ARCH="${ARCH:-}"
SUBPROJECT="${SUBPROJECT:-}"

# We want to start off imagecraft builds with just amd64 support right now
case $ARCH in
  amd64)
    ;;
  *)
    echo "imagecraft build is currently not implemented for ARCH=${ARCH:-unset}."
    exit 0
    ;;
esac

case ${SUBPROJECT} in
  minimized)
    ;;
  *)
    echo "imagecraft build is currently not implemented for SUBPROJECT=${SUBPROJECT:-unset}."
    exit 0
    ;;
esac

_src_d=$(dirname $(readlink -f ${0}))

snap install imagecraft --classic --channel latest/edge

cp -r "$_src_d"/imagecraft-configs/* .

LB_PARENT_MIRROR_BINARY="${LB_PARENT_MIRROR_BINARY}" \
LB_PARENT_MIRROR_BINARY_SECURITY="${LB_PARENT_MIRROR_BINARY_SECURITY}" \
LB_DISTRIBUTION="${LB_DISTRIBUTION}" \
CRAFT_BUILD_ENVIRONMENT=host imagecraft --verbosity debug pack

# We are using this function instead of mount_disk_image from functions
# because imagecraft doesn't currently support XBOOTLDR's GUID and
# mount_disk_image has an explicit check for the XBOOTLDR GUID
# TODO: Use mount_disk_image once imagecraft supports XBOOTLDR's GUID
mount_image_partitions() {
  mount_image "${disk_image}" "$ROOT_PARTITION"

  # Making sure that the loop device is ready
  partprobe "${loop_device}"
  udevadm settle
  mount_partition "${rootfs_dev_mapper}" "$mountpoint"
  mount "${loop_device}p13" "$mountpoint/boot"
  mount "${loop_device}p15" "$mountpoint/boot/efi"
}

install_grub_on_image() {
  echo "(hd0) ${loop_device}" > "$mountpoint/tmp/device.map"
  mkdir -p "$mountpoint/etc/default/grub.d"
  efi_boot_dir="/boot/efi/EFI/BOOT"
  chroot "$mountpoint" mkdir -p "${efi_boot_dir}"

  # UEFI GRUB install (primary boot method)
  chroot "$mountpoint" grub-install "${loop_device}" \
    --boot-directory=/boot \
    --efi-directory=/boot/efi \
    --target=x86_64-efi \
    --uefi-secure-boot \
    --no-nvram

  # BIOS GRUB install (fallback boot method)
  chroot "$mountpoint" grub-install --target=i386-pc "${loop_device}"

  # Use initrdless boot for minimal images
  if [ "${SUBPROJECT:-}" = "minimized" ]; then
    force_boot_without_initramfs "$mountpoint"
  fi

  divert_grub "$mountpoint"
  track_initramfs_boot_fallback "$mountpoint"
  chroot "$mountpoint" update-grub
  
  # For the error: [FAILED] Failed to start grub2-common.service
  # chroot "$mountpoint" grub-editenv /boot/grub/grubenv create
  replace_grub_root_with_label "$mountpoint"
  undivert_grub "$mountpoint"

  rm "$mountpoint/tmp/device.map"

  echo "GRUB installed successfully."
}

unmount_image_partitions() {
  umount "$mountpoint/boot/efi"
  umount "$mountpoint/boot"

  umount_partition "$mountpoint"
  rmdir "$mountpoint"
}

cleanup_image_state() {
  local root="$1"

  rm -f "$root"/etc/ssh/ssh_host_*key*

  rm -f "$root"/boot/initrd.img
  rm -f "$root"/boot/initrd.img.old

  rm "$root"/etc/passwd-                 || echo "No spare passwd file to cleanup"
  rm "$root"/etc/shadow-                 || echo "No spare shadow file to cleanup"
  rm "$root"/etc/gshadow-                || echo "No spare gshadow file to cleanup"
  rm "$root"/etc/group-                  || echo "No spare group file to cleanup"
  rm "$root"/etc/apt/conf.d/00secure     || echo "No apt cache to cleanup"
  rm -rf "$root"/var/log/private

  # truncate machine-id for first-boot detection
  truncate -s 0 "$root"/etc/machine-id
  rm -f "$root"/var/lib/dbus/machine-id

  # Updating resolv.conf.tmp because
  # teardown_mountpoint (called by umount_partition) will overwrite
  # etc/resolv.conf with resolv.conf.tmp, undoing any fix made there.
  rm -f resolv.conf.tmp
  ln -sf ../run/systemd/resolve/stub-resolv.conf resolv.conf.tmp

  # Trimming transient package state.
  chroot "$mountpoint" apt-get autoremove --purge --assume-yes
  chroot "$mountpoint" apt-get -y clean
}

disk_image="pc.img"
ROOT_PARTITION=1
mountpoint=$(mktemp -d)

mount_image_partitions

snap_prepare "$mountpoint"
install_grub_on_image

# Creating a build.info for cloud-init
mkdir -p "$mountpoint/etc/cloud"
cat > "$mountpoint/etc/cloud/build.info" << EOF
build_name: minimal
serial: ${BUILDSTAMP}
EOF

cleanup_image_state "$mountpoint"
create_manifest  "$mountpoint/" "$PWD/livecd.ubuntu-cpc.imagecraft.manifest" "$PWD/livecd.ubuntu-cpc.imagecraft.spdx"  "cloud-image-$ARCH-$(date +%Y%m%dT%H:%M:%S)" "false"

unmount_image_partitions

clean_loops
trap - EXIT

qemu-img convert -f raw -O qcow2 "${disk_image}" livecd.ubuntu-cpc.imagecraft.img
