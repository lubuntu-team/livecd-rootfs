#!/bin/bash -eux
# vi: ts=4 noexpandtab

. config/functions

case $PASS in
    ubuntu-server-minimal.ubuntu-server.installer.*.*)
        exit 0
        ;;
    ubuntu-server-minimal.ubuntu-server.installer.*)
        flavor=${PASS##*.}
        ;;
    *)
        exit 0
        ;;
esac

# Install kernel and initrd directly into the ISO casper directory
iso_install_kernel "$flavor" chroot/boot/vmlinu?-* chroot/boot/initrd.img-*
